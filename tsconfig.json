{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,

		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,

		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"types": ["bun", "vite/client"]
	},
	"include": ["src/**/*", "web/src/**/*", "web/*.ts"],
	// The service worker is checked by `tsconfig.sw.json` instead, against the `webworker`
	// lib. It cannot be in both projects: the globals it uses do not exist here, and adding
	// the lib that declares them collides with `dom`. See that file's own note.
	"exclude": ["web/src/sw.ts"]
}
