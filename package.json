{
  "name": "finderr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast media request UI for the arr stack. Local title index, sub-millisecond search.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "bun run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "bun src/server/index.ts",
    "index:build": "bun src/jobs/build-index.ts",
    "index:refresh": "bun src/jobs/refresh.ts",
    "index:vocab": "bun src/jobs/build-vocab.ts",
    "logos:import": "bun src/jobs/import-logos.ts",
    "awards:import": "bun src/jobs/import-awards.ts",
    "search:report": "bun src/jobs/search-report.ts",
    "icons:build": "bun src/jobs/build-icons.ts",
    "spellfix:build": "cc -O2 -fPIC -shared -I$(brew --prefix sqlite)/include vendor/sqlite-spellfix/spellfix.c -o vendor/sqlite-spellfix/spellfix1.dylib",
    "test": "bun test src",
    "test:web": "bun test web/src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-router": "^1.170.32",
    "cockatiel": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
