# Copy to .env -- docker-compose.yml reads these. Never commit the real file.
#
# > [!IMPORTANT] Do NOT use FINDERR_-prefixed names in this file
# > Bun auto-loads .env from the working directory, and the app reads FINDERR_* straight
# > out of the environment. A FINDERR_ key here is therefore not inert: it configures the
# > app for every `bun test` and `bun run` on the HOST, outside the container entirely.
# > Compose maps each unprefixed name below onto its FINDERR_ variable.
# > `src/lib/env-hygiene.test.ts` fails the suite if a FINDERR_ key appears here.

# --- Radarr and Sonarr. The keys are REQUIRED; the app refuses to boot without them.
# Find each under Settings -> General in the respective web UI.
RADARR_API_KEY=
SONARR_API_KEY=

# --- Where the arrs live. Defaults assume finderr shares a Docker network with them;
# set these to LAN addresses (http://10.0.0.10:7878) if it does not.
#RADARR_URL=http://radarr:7878
#SONARR_URL=http://sonarr:8989

# --- Root folders, AS THE ARR SEES THEM rather than as finderr does.
#RADARR_ROOT_FOLDER=/media/movies
#SONARR_ROOT_FOLDER=/media/tv

# --- Quality profile ids. 4 is HD-1080p on a default install; check yours.
#RADARR_QUALITY_PROFILE_ID=4
#SONARR_QUALITY_PROFILE_ID=4

# --- TMDB. OPTIONAL. Every facet that ships works keylessly through the Servarr
# proxies; this buys the two things nothing keyless carries -- streaming availability
# and keywords for series. https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Plex. OPTIONAL. Without it a title's Play button is absent and nothing else
# changes. The token is FULL ACCOUNT ACCESS -- finderr only reads, but the token does
# not know that. It travels as a header, never a query parameter.
#PLEX_URL=http://plex:32400
PLEX_TOKEN=

# --- Auth. finderr is invite-only; the first boot prints an invite link for the first
# admin account.
#
# > [!CAUTION] AUTH_RP_ID IS PERMANENT -- set it before the first passkey is registered
# > It is the relying-party id every credential is bound to. Change it afterwards and
# > every passkey ever registered stops verifying, for everyone, with no migration short
# > of re-inviting every user. Use the BARE DOMAIN finderr will finally live at: no
# > scheme, no port. Leave it unset only while nobody has registered one yet.
#
# A passkey also cannot be created over plain http -- browsers require a secure context,
# and `localhost` is the only exemption. On a plain-http LAN the working door is
# "Continue with Plex"; the passkey buttons hide themselves and say why.
#AUTH_RP_ID=finderr.example.com
#AUTH_RP_NAME=finderr
# Comma-separated. EVERY origin that may complete a ceremony must be listed. The session
# cookie's Secure flag is derived from these: it turns on only when all are https.
#AUTH_ORIGINS=https://finderr.example.com,http://localhost:7979
# Lets an agent administer finderr without being a person: mint invites, manage users.
# OPTIONAL -- without it the admin API is reachable only by an admin's own session.
#
# It also unlocks the full /api/health payload. Anonymous callers get `{"ok":true}` and
# nothing else, because that endpoint has to stay open for the container probe and the
# detail (Plex machine id, library sizes, memory) is not for strangers.
ADMIN_API_KEY=

# Set to true ONLY when a reverse proxy YOU control terminates connections in front of
# finderr. It decides whether X-Forwarded-For is believed when identifying a caller for
# rate limiting, and it is wrong in both directions:
#   off behind a proxy -> every request shares one bucket, so the first abuser locks
#                         out every user and the limiter cannot tell them apart
#   on without a proxy -> the header is client-controlled, so an attacker has an
#                         unlimited supply of identities and the limiter never fires
#AUTH_TRUST_PROXY=false
